# gsieve settings for RSA-270 (895 bits). Sourced by the scripts in ../scripts.
#
# STARTING POINT, NOT TUNED. These start from the published RSA-260 run
# (degree 6, A=33, lim 2^31, lpb 36/37, mfb 72/111, special-q 1e9..3.9e10) with
# one extra large-prime bit, because RSA-270 is ~2.5x more work. Before a full
# run, test-sieve (scripts/test_sieve.sh) this set and CADO's own c270 set
# (I=18, lpb 38/39, mfb 109/120, see cado-nfs/parameters/factor/params.c270)
# and keep whichever gives the lowest estimated GPU-days.

N=233108530344407544527637656910680524145619812480305449042948611968495918245135782867888369318577116418213919268572658314913060672626911354027609793166341626693946596196427744273886601876896313468704059066746903123910748277606548649151920812699309766587514735456594993207

POLY=rsa270.poly            # from scripts/polyselect.sh (CADO-NFS polynomial selection)
FB1=rsa270.roots1.gz        # from scripts/makefb.sh

A=33                        # log2 sieve area per special-q (I = 2^17, J = 2^16)
LIM0=2147483647             # factor-base bounds (must be < 2^32)
LIM1=2147483647
LPB0=37                     # large-prime bounds (bits)
LPB1=38
MFB0=74                     # cofactor bounds (bits): 2 large primes rational,
MFB1=111                    # 3 large primes algebraic
SQSIDE=1                    # special-q on the algebraic side
QMIN=1000000000             # special-q range for the whole run
QMAX=60000000000
QCHUNK=20000                # special-q range per work unit (one output file)
LOGREG=16                   # 2^16-cell regions: needs >= 132 KB shared memory (A100/H100/B200)
